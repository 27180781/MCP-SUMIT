# ---- Server ----
PORT=8080
HOST=0.0.0.0
# Public URL of this server (needed for OAuth / Claude.ai custom connectors). Must be https in production.
PUBLIC_URL=http://localhost:8080
# Set to "true" when running behind a reverse proxy (Railway, Render, nginx, Cloudflare...)
TRUST_PROXY=false

# ---- Security ----
# Master key used to encrypt Sumit API keys at rest. Generate with: openssl rand -hex 32
# If omitted, a key is generated and stored in DATA_DIR/master.key
MASTER_KEY=
# Admin console password. If omitted, you will be asked to create one on first visit to /admin
ADMIN_PASSWORD=
# Allow tokens embedded in the URL (/mcp/t/<token>) - needed for clients that cannot send headers
ALLOW_URL_TOKENS=true
# Enable the built-in OAuth 2.1 authorization server (recommended for Claude.ai custom connectors)
OAUTH_ENABLED=true

# ---- Storage ----
DATA_DIR=./data

# ---- Sumit ----
SUMIT_BASE_URL=https://api.sumit.co.il
SUMIT_TIMEOUT_MS=60000

# ---- stdio mode (local Claude Desktop / Claude Code) ----
# Either configure accounts in the admin console (shared DATA_DIR) or set a single account here:
SUMIT_COMPANY_ID=
SUMIT_API_KEY=
SUMIT_ACCOUNT_NAME=
# Or several accounts as JSON: [{"name":"עסק א","companyId":123,"apiKey":"..."},{"name":"עסק ב","companyId":456,"apiKey":"..."}]
SUMIT_ACCOUNTS=
