# Paste into CapRover → App → App Configs → Environment Variables → "Bulk Edit".
# Replace the values marked <...>.
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
DATA_DIR=/data
PUBLIC_URL=https://<app-name>.<root-domain>
TRUST_PROXY=true
MASTER_KEY=<openssl rand -hex 32>
ADMIN_PASSWORD=<strong password, 8+ chars>
ALLOW_URL_TOKENS=true
OAUTH_ENABLED=true
SUMIT_BASE_URL=https://api.sumit.co.il
SUMIT_TIMEOUT_MS=60000
LOG_LEVEL=info
